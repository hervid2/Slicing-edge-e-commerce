# apps/api/.env.example
# API runtime configuration for local development.

# Required: PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/slicing_edge?schema=public"

# Required: JWT/Auth secret used by API token verification.
AUTH_SECRET="generate-with-npx-auth-secret"

# Required for Stripe checkout + webhook verification.
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Required for absolute URLs in redirects/emails.
FRONTEND_URL="http://localhost:3000"

# Optional: transactional emails. If missing, API falls back to logs.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Required for admin image uploads to Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# API server settings.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
