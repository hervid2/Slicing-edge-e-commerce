# apps/api/.env.example
# API runtime configuration for local development.

# Required: PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/slicing_edge?schema=public"

# Required: JWT/Auth secret used by API token verification.
AUTH_SECRET="generate-with-npx-auth-secret"

# Required for Stripe checkout + webhook verification.
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Required for absolute URLs in redirects/emails.
FRONTEND_URL="http://localhost:3000"

# Production: comma-separated list of allowed CORS origins (overrides FRONTEND_URL).
# Example: ALLOWED_ORIGINS="https://slicing-edge.vercel.app,https://preview.slicing-edge.vercel.app"
ALLOWED_ORIGINS=""

# Optional: Upstash Redis for distributed rate limiting across multiple API instances.
# When unset, the API falls back to in-memory @fastify/rate-limit (single instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: transactional emails. If missing, API falls back to logs.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Required for admin image uploads to Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# API server settings.
# Optional: Groq AI for the chatbot assistant (free tier available at console.groq.com).
GROQ_API_KEY=""

# API server settings.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
