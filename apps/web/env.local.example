# apps/web/env.local.example
# Frontend environment variables for local development.

# Public API base URL consumed by browser/server components in the web app.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Canonical URL of this web app — used for metadataBase, OG images, sitemaps.
# In production set to: https://slicing-edge.vercel.app (or your custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js configuration used by web auth handlers.
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Optional OAuth credentials for Google provider.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional public Stripe key for client-side Stripe integrations.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
