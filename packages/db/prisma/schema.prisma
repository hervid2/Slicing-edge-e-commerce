generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──── ENUMS ────
// User authorization levels used across API middleware and admin routes.

enum UserRole {
  CUSTOMER
  ADMIN
}

// Order lifecycle states synchronized by checkout flow + Stripe webhooks.
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ──── AUTH.JS REQUIRED MODELS ────
// These models must stay compatible with Auth.js adapters.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ──── BUSINESS MODELS ────

// Primary user profile used by both credentials and OAuth flows.
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole   @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  cart          Cart?
  wishlist      Wishlist[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("users")
}

// Normalized user addresses used for checkout prefill and account management.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  street    String
  city      String
  state     String
  zipCode   String
  country   String   @default("US")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// Product taxonomy used for navigation, filtering, and merchandising.
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

// Core product entity. `version` supports optimistic stock updates.
model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String         @db.Text
  price          Decimal        @db.Decimal(10, 2)
  compareAtPrice Decimal?       @db.Decimal(10, 2)
  currency       String         @default("USD")
  stock          Int            @default(0)
  version        Int            @default(0)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  reviews        Review[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistedBy   Wishlist[]
  avgRating      Float          @default(0)
  reviewCount    Int            @default(0)
  isFeatured     Boolean        @default(false)
  isActive       Boolean        @default(true)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@map("products")
}

// Product media layer; stores Cloudinary identifiers for lifecycle operations.
model ProductImage {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url                String
  cloudinaryPublicId String
  altText            String?
  position           Int      @default(0)
  createdAt          DateTime @default(now())

  @@map("product_images")
}

// User-specific favorite products (auth-only feature).
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

// Shopping cart supports either authenticated userId or guest sessionId.
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

// Cart line items keep quantity only; product details are resolved dynamically.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

// Order snapshot stores immutable pricing values for historical correctness.
model Order {
  id                    String               @id @default(cuid())
  orderNumber           String               @unique
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id])
  guestEmail            String?
  guestToken            String?              @unique
  status                OrderStatus          @default(PENDING)
  subtotal              Decimal              @db.Decimal(10, 2)
  shippingCost          Decimal              @db.Decimal(10, 2) @default(0)
  tax                   Decimal              @db.Decimal(10, 2) @default(0)
  total                 Decimal              @db.Decimal(10, 2)
  currency              String               @default("USD")
  stripePaymentIntentId String?              @unique
  stripeSessionId       String?              @unique
  trackingNumber        String?
  carrierName           String?
  // Shipping address snapshot captured at checkout time.
  shippingAddress       Json
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  returnRequests        ReturnRequest[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userId])
  @@index([guestEmail])
  @@index([orderNumber])
  @@map("orders")
}

// Order item snapshot preserves name/price/image at purchase time.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  productPrice Decimal  @db.Decimal(10, 2)
  productImage String?
  quantity     Int
  createdAt    DateTime @default(now())

  @@map("order_items")
}

// Append-only timeline of order state transitions for full auditability.
model OrderStatusHistory {
  id               String      @id @default(cuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           OrderStatus
  note             String?
  changedByAdminId String?
  createdAt        DateTime    @default(now())

  @@map("order_status_history")
}

// Return request statuses covering the full admin RMA workflow.
enum ReturnStatus {
  PENDING      // Customer submitted, awaiting admin review
  APPROVED     // Admin approved the return
  REJECTED     // Admin rejected the return
  LABEL_ISSUED // Return shipping label sent to customer
  RECEIVED     // Product received back at warehouse
  REFUNDED     // Refund processed (Stripe)
  CLOSED       // Process complete, no further action needed
}

// Customer return requests linked to a specific order.
model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  email       String
  reason      String
  description String       @db.Text
  status      ReturnStatus @default(PENDING)
  adminNote   String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

// Contact form submissions from store visitors.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("contact_messages")
}

// Frequently asked questions managed by admins.
model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("faq_entries")
}

// Product reviews are constrained to one review per user/product pair.
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
}
