# Root environment template (shared/local defaults)
# IMPORTANT: Never commit real secrets. Use placeholders only.
# Additional templates:
# - apps/api/.env.example
# - apps/web/env.local.example
# - packages/db/.env.example
# - packages/email/.env.example

# ──── Database (CRITICAL) ────
# Required by API + Prisma. Local dev and CI will fail without this.
DATABASE_URL="postgresql://user:password@localhost:5432/slicing_edge?schema=public"

# ──── Auth.js (CRITICAL) ────
# AUTH_SECRET signs JWT/session data. Keep long/random in real environments.
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ──── Stripe (CRITICAL for checkout) ────
# Secret keys must stay server-side only.
STRIPE_SECRET_KEY=""
# Set from `stripe listen --forward-to ...` in local webhook testing.
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ──── Resend (Email) ────
# Optional in local dev (API falls back to structured logs).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ──── Cloudinary ────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ──── Anthropic (Chatbot) ────
ANTHROPIC_API_KEY=""

# ──── Upstash Redis (Rate Limiting) ────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ──── App URLs (CRITICAL) ────
# NEXT_PUBLIC_* variables are exposed to the browser by design.
NEXT_PUBLIC_API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# ──── Sentry (Error Tracking) ────
# Create a project at sentry.io and copy the DSN here.
# NEXT_PUBLIC_SENTRY_DSN is safe to expose to the browser (it's a public key).
NEXT_PUBLIC_SENTRY_DSN=""
# Used by @sentry/nextjs to upload source maps during CI/Vercel builds.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ──── Vercel Analytics ────
# No extra env vars needed — @vercel/analytics auto-activates on Vercel.
# Add NEXT_PUBLIC_VERCEL_ANALYTICS_ID if using a custom domain or self-hosting.

# ──── App URLs (CRITICAL) ────
# NEXT_PUBLIC_* variables are exposed to the browser by design.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──── API Server ────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
